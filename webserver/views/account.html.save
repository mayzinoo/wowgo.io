                                                <td>{{=tip.sender}}</td>
                                                <td>{{=tip.recipient}}</td>
                                                <td>{{#def.format: {n: tip.amount, decimals: 2 } }}</td>
                                                <td>{{#def.format: {n: tip.commission, decimals: 2 } }}</td>
                                                <td class="show-for-large-up">{{=tip.tipTxId}}</td>
                                                <td class="show-for-large-up">{{=tip.created}}</td>
                                            </tr>
                                        {{~}}
                                    </tbody>
                                </table>
                            </div>
                            {{??}}
                              <br>
                            <br>
                            <br>
                            <p>You have no tip history in your account.</p>
                            {{?}}
                                    <a href="#" class="optin-close">&times;</a>
                                </div>
                    
                   </div> 
                   <!-- End Tip -->
                   <!-- Success Tip -->
                   <div class="tip">                    
                        <div class="bg-overlay" id="tip-send-successfully">
                                <div class="subscribe-optin">
                                    <h4>Tip Sent Successfully.</h4>
                                    <a href="#" class="optin-close">&times;</a>                                    
                                </div>                    
                        </div> 
                    </div> 
                    <!-- End Success Tip -->

                    <div class="bg-overlay" id="tip-send">
                         <div class="subscribe-optin">
                            <h5>Send Tip</h5>
                            <p>You can send the tip as much as you want, to whomever you want.<br/>
                            Tip will be delivered to the designated User ID immediately, and cannot be returned.</br>
                            Recheck before submit.</p>
                            <form action="/tip-send" method="post">
                                <!-- fake fields are a workaround for chrome autofill getting the wrong fields -->
                                <input style="display:none" type="text" name="fakeusernameremembered"/>
                                <input style="display:none" type="password" name="fakepasswordremembered"/>

                                <input type="hidden" name="tipTxId" value="{{= it.id}}" />
                                <label for="amount">Amount</label>
                                <input type="text"  id="your_amount" name="your_amount"  placeholder="{{= it.tipFee }}" min="{{= it.tipFee }}"  required/>
                                <label for="recipient">Recipient User ID</label>
                                <input type="text" id="recipient" name="recipient" required/>
                                <label for="password">Your Password</label>
                                <input type="password" id="your_password" name="your_password" autocomplete="off"/>
                                {{?it.user.mfa_secret}}
                                    <label for="otp">2FA Code</label>
                                    <input type="text" id="otp" name="otp" autocomplete="off" pattern="[0-9]{6}" required />
                                {{?}}
                                <a href="#tip" class="border-button ">Back</a>

                                <script>
                                    var i = 2;
                                    $(document).ready(function(){
                                        $("#your_amount").on("keypress", function(event) {                                           
                                           var that = $("#your_amount").val();                                           
                                           if (event.which < 48 || event.which > 57) {
                                                event.preventDefault();
                                            } else {
                                                $(this).val($(this).val().replace(/[^\d].+/, ""));
                                            }                                            
                                        });
                                    });
                                </script>                               

                               <!--Tip send Button unactive STATUS-->

                                <!--input class="border-button right blue" type="submit" value="submit"/ -->

                                <input class="border-button right blue" type="submit" value="submit">


                                <!--Tip send save Button unactive STATUS-->
                            </form>
                            <a href="#" class="optin-close">&times;</a>
                        </div>
                    </div>
                </div><!-- end support -->
            </div>
            <div class="col-md-6 col-sm-12 right-column">
