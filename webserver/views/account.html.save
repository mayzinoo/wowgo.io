                                                    <label for="confirmation">Confirm Password</label>
                                                    <input name="confirmation" type="password" id="confirmation" pattern=".{7,50}" required/>



                                                    <!--Password change save Button unactive STATUS-->

                                                    <input type="submit" class="border-button blue right" value="Change">

                                                    <!--Password change save Button unactive STATUS-->


                                                </form>

                                        </div>
                                       
                                        
                                   
                                
                        <hr>
                       
                                <a href="#" class="optin-close">&times;</a>
                            </div>
                    </div>
                </div><!-- end security -->
                <div class="withdraw">
                    <div class="box">
                        <a class="button arrow" href="#withdraw">Withdraw</a>
                    </div>
		<div class="bg-overlay" id="withdrawnew">
			<div class="subscribe-optin currency">
			<h5>Withdrawal Request</h5>
			<ul>
				<li><input type="radio" id="3" class="withdrawal" name="ethe"> ETH</li>
				<li><input type="radio" id="4" class="withdrawal" name="usd"> USD</li>
				<li><input type="radio" id="4" class="withdrawal" name="krw"> KRW</li>
				<li><input type="radio" id="4" class="withdrawal" name="vnd"> VND</li>
			</ul>
			<div id="div3" class="mid_padding">
				<label>Please input the amount</label>
				<input type="text" name="wowamt" class="form-control">
				<p>Please input the bank account information</p>
				<label>Country</label>
				<input type="text" name="country" class="form-control">
				<label>Bank Name</label>
				<input type="text" name="bankname" class="form-control">
				<label>Owner Name</label>
				<input type="text" name="name" class="form-control">
				<label>Account Address</label>
				<input type="text" name="acctaddress" class="form-control">

				<input type="submit" class="right btn btn-success" value="Submit">
			</div>
			<div id="div4" class="mid_padding">
				<label>Please input the amount</label>
				<input type="text" name="wowamt" class="form-control">

				<label>Please input the Ethereum Address</label>
				<input type="text" name="etheaddress" class="form-control">

				<input type="submit" class="right btn btn-success" value="Submit">
			</div>
			<a href="#" class="optin-close">&times;</a>
			</div>
		</div>
                    <div class="bg-overlay" id="withdraw">
                                <div class="subscribe-optin">
                                    <a class="border-button right green" href="#widthdraw-request">Request Withdraw</a>
                            <h5 >Withdraw History</h5>
                            {{?it.user.withdrawals.length > 0}}
                                <table>
                                    <thead>
                                        <tr>
                                            <td>WoW</td>
                                            <td>Destination</td>
                                            <td>Status</td>
                                            <td class="show-for-large-up">Created</td>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{~it.user.withdrawals :withdrawal:index}}
                                            <tr>
                                                <td>{{#def.format: {n: withdrawal.amount*-1, decimals: 2 } }}</td>
                                                <td>
                                                    <a href="https://etherscan.io/tx/{{=withdrawal.ethereum_withdrawal_txid}}"  target="_blank">Link</a>
                                                </td>
                                                <td>
                                                    {{?withdrawal.status}}
                                                         <a href="https://etherscan.io/tx/{{=withdrawal.status}}" target="_blank">Transferred</a>
                                                    {{??}}
                                                        in progress
                                                    {{?}}
                                                </td>
                                                <td class="show-for-large-up">{{=withdrawal.created}}</td>
                                            </tr>
                                        {{~}}
                                    </tbody>
                                </table>
                            {{??}}
                                <br>
                                <br>
                                <br>
                                <p>You have no withdrawals in your account.</p>
                            {{?}}
                                    <a href="#" class="optin-close">&times;</a>
                                </div>
                    </div>
                    <div class="bg-overlay" id="widthdraw-request">
                        <div class="subscribe-optin">
                            <h4>Withdrawal WoW</h4>
            
                            <p>
                                <strong>Note:</strong> If you bet on the current game, some of the balance may not be withdrawn.
                            </p>
                            <form action="/withdraw-request" method="post">
                                <!-- fake fields are a workaround for chrome autofill getting the wrong fields -->
                                <input style="display:none" type="text" name="fakeusernameremembered"/>
                                <input style="display:none" type="password" name="fakepasswordremembered"/>

                                <label for="amount">WoW amount</label>
                                <input oninput="updateTotal()" type="number" id="amount" name="amount" placeholder="Min {{= it.minWithdraw }} Bits" min="{{= it.minWithdraw }}" step="0.01" required/>
                                <label for="destination">Destination Address</label>
                                <input type="text" id="destination" name="destination" required/>
                                <label for="password">Your password</label>
                                <input type="password" id="password" name="password" autocomplete="off"/>
                                {{?it.user.mfa_secret}}
                                    <label for="otp">2FA Code</label>
                                    <input type="text" id="otp" name="otp" autocomplete="off" pattern="[0-9]{6}" required />
                                {{?}}

                                <a href="#withdraw" class="border-button ">Back</a>
                                <div class="right">
                                    <span style="font-size: 12px; color:#484848; margin-right: 3px; margin-top: 10px;">FEE: {{= it.miningFee}} WoW // <strong>TOTAL: <span id="total">0</span> WoW</strong></span>


                                    <!--Tip send Button unactive STATUS-->
                                    <!--input class="border-button right blue" type="submit" value="Proceed"/-->
                                    <!--Tip send Button unactive STATUS-->
                                </div>
                                <input type="hidden" name="withdrawal_id" value="{{= it.id}}" />
                            </form>
                            <a href="#" class="optin-close">&times;</a>
                        </div>
                    </div>
                </div><!-- end withdraw -->
                <div class="support">
                    <div class="box">
                        <a class="button arrow" href="#support">Support</a>
                    </div>
                    <div class="bg-overlay" id="support">
                                <div class="subscribe-optin">
                                    <h5>Need help? <br> <br>Please contact to <br> <br>Telegram @wowgohelper</h5>
                                    <a href="#" class="optin-close">&times;</a>
                                </div>
                    </div>
                </div><!-- end support -->
               
            </div>
         </div>  
    <div class="col-md-12 col-sm-12 nopadding right-column">
         <div class="col-md-6 col-sm-12 center">
            <div class="logout">
                <div class="box">
                    <a onclick="logout();" class="logout-btn">
                        Logout
                    </a>
                </div>
            </div><!-- end logout -->
         </div>
    </div>
    </div> 

    
    </div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<script>
	$(function() {
  $('.hidden').hide();
  $('.trigger').change(function() {  
    var hiddenId = $(this).attr("data-trigger");
    if ($(this).is(':checked')) {      
      $("#" + hiddenId).show();
    } else {     
      $("#" + hiddenId).hide();          
    }
  });
});
</script>
<script>
$(document).ready(function(){	



});
</script>
<script>

   $(document).ready(function() {
  

	$(".withdrawal").on("change", function() {
   if ($('.withdrawal#3').is(':checked')) {  
    $('#div4').show("slow");        
    $('#div3').hide();                   


    } else if ($(".withdrawal#4").is(":checked")) {
    $('#div3').show("slow");
    $('#div4').hide();
    }
    });

    });

</script>
#}}
{{#def.include('./template/main_new')}}
