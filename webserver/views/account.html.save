{{##def.page_title = 'Your account' #}}
{{##def.content:
<script type="text/javascript">
    window.onload = function () {
        if (document.getElementById('confirmation') !== null) {
            document.getElementById('confirmation').onchange = validatePassword;
            document.getElementById('password').onchange = validatePassword;
        }
    };
    function validatePassword() {
        var password = document.getElementById('new_password').value;
        var confirm = document.getElementById('confirmation').value;
        if (password != confirm) {
            document.getElementById('confirmation').setCustomValidity("Confirmation and password should be the same");
        } else document.getElementById("confirmation").setCustomValidity('');
    }
    function logout() {
        if (document.getElementById('logout') ) {
            if (confirm("Are you sure you want to log out?")) {
                document.getElementById("logout").submit();
            }
        }
    }
</script>
<form action="/logout" method="post" id='logout'></form>
<div class="content row panel radius">
 
    <div class="settings">
    
        <div class="col-md-12 col-sm-12">
            <div class="col-md-6 col-sm-12">
                <div calss="account">
                    <div class="box">
                        <a class="button arrow" href="#account">Account</a>
                    </div>
                    <div class="bg-overlay" id="account">
                        <div class="subscribe-optin">
                            <h5>Account</h5>
                    
                    <p class="account">
                        <b>Deposit Address:</b>
                        <input type="text" value="{{=it.user.deposit_address}}" readonly>
                        <!-- <a href="ethereum:{{=it.user.deposit_address}}?message=deposit">Ethereum link</a> -->
                        <a href="https://etherscan.io/address/{{=it.user.deposit_address}}" target="_blank">etherscan explore</a>
                    </p>
                    <div class="row">
                        <div class="large-5 columns">
                            <img class="show-for-medium-up qr" src="https://blockchain.info/qr?data={{=it.user.deposit_address}}&size=150" alt=""/>
                        </div>
                
                    </div>
                    <br>
                    <h5>Account Information</h5>
                    <div id="statistics" class="row">
                        <div class="data col-md-3 col-sm-12">
                            <p><b>Deposits </b></p>
                            <h6>{{#def.format:{n: it.user.depositsSum, decimals:2} }} WoW</h6>
                        </div>
                        <div class="data col-md-3 col-sm-12">
                            <p><b>Withdrawals </b></p>
                            <h6>{{#def.format:{n: it.user.withdrawlsSum, decimals:2} }} WoW</h6>
                        </div>
                        <div class="data col-md-3 col-sm-12">
                            <p><b>Bonus</b></p>
                            <h6>{{#def.format:{n: it.user.giveaways, decimals:2} }}</h6>
                        </div>
                        <div class="data col-md-3 col-sm-12">
                            <p><b>Net Profit</b></p>
                            <h6>{{#def.format:{n: it.user.net_profit, decimals:2} }} WoW</h6>
                        </div>
                    </div>

                    <br>
                    
                            <a href="#" class="optin-close">&times;</a>
                        </div>
                    </div>
                </div><!-- end acccount -->                
                <div class="deposit">
                    <div class="box">
                        <a class="button arrow" href="#deposit-popup">Deposit</a>
                    </div>
		
                    <div class="bg-overlay" id="deposit-popup">
                                <div class="subscribe-optin">
                                    <h5 class="">Deposit History</h5>
                               
                                <p class="account">
                                    <b>Deposit Address:</b>
                                    <input type="text" value="{{=it.user.deposit_address}}" readonly>
                                    <!-- <a href="ethereum:{{=it.user.deposit_address}}?message=deposit">Ethereum link</a> -->
                                    <a href="https://etherscan.io/address/{{=it.user.deposit_address}}">Ethereum link</a>
                                </p>
                                {{?it.user.deposits.length > 0}}
                                    <table>
                                        <thead>
                                            <tr>
                                                <td>WoW</td>
                                                <td>Transaction</td>
                                                <td class="show-for-medium-up">Created</td>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{~it.user.deposits :deposit:index}}
                                                <tr>
                                                    <td>{{#def.format: {n: deposit.amount, decimals: 2 } }}</td>
                            <td><a href="https://etherscan.io/tx/{{=deposit.ethereum_deposit_txid}}" target="_blank">View</a></td>
                                                    <td class="show-for-medium-up">{{=deposit.created}}</td>
                                                </tr>
                                            {{~}}
                                        </tbody>
                                    </table>
                                {{??}}
                                    <p>You don't have deposits</p>
                                {{?}}
                                    <a href="#" class="optin-close">&times;</a>
                                </div>
                    </div>
		<div class="bg-overlay" id="depositnew-popup">
			<div class="subscribe-optin currency deposit">
				<h5>Deposit Request</h5>
				<ul>
				<li><input type="checkbox" id="1" data-trigger="div2" class="trigger" name="ethe"> ETH</li>
				<li><input type="checkbox" id="2" data-trigger="div1" class="trigger" name="usd"> USD</li>
				
				<li><input type="checkbox" id="3" data-trigger="div1" class="trigger" name="krw"> KRW</li>
					
				<li><input type="checkbox" id="4" data-trigger="div1" class="trigger" name="vnd"> VND</li>
				
				</ul>
			<div id="div1" class="hidden mid_padding">
				<div class="col-md-6">
				<p>Please Input the amount</p>
				<input type="text" name="currency-amt" id="usdamt" class="form-control currencychange">USD
				<input type="text" name="wow-amt" id="wowamt" class="form-control">WoW<br/>
				<p>Please input the deposit's name</p>
				<input type="text" name="deposit-name" class="form-control">
				</div>
				<div class="col-md-6">
				<p>Deposit Address</p>
				<label>Bank Info</label>
				<input type="text" name="bankname" class="form-control">
				<label>Account Owner</label>
				<input type="text" name="name" class="form-control">
				<label>Account Address</label>
				<input type="text" name="acctaddress" class="form-control">
	
				<input type="submit" class="right btn btn-success" value="Submit"><br/>
				</div>
			</div>
			<div id="div2" class="hidden mid_padding">
				<p>ETH Deposit is made by automatic, just input the ethereum at your deposit address.</p>
				<input type="text" value="{{=it.user.deposit_address}}" readonly>
                                    
                                    <a href="https://etherscan.io/address/{{=it.user.deposit_address}}">Ethereum link</a>
				<input type="submit" class="right btn btn-success" value="Done">
			</div>
			<a href="#" class="optin-close">&times;</a>
			</div>
		</div>
                </div><!-- end deposit -->
                
                <!-- Start Tip -->
                <div class="tip">
                    <div class="box">
                        <a class="button arrow" href="#tip">Tip</a>
                    </div>
                    <div class="bg-overlay" id="tip">
                                <div class="subscribe-optin">
                                    <a class="border-button right green" href="#tip-send">Send Tip</a>
                                    <h5 >Tip History</h5>
                                    <hr>
                                {{?it.user.tips.length > 0}}    
