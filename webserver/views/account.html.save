                                    <thead>
                                        <tr>
                                            <th>From</th>
                                            <th>To</th>
                                            <th>Amount</th>
                                            <th>Commission</th>
                                            <th class="show-for-large-up">Transaction ID</th>
                                            <th class="show-for-large-up">Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{~it.user.tips :tip:index}}
